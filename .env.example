# --- Project / Client ---
PROJECT_NAME=odoo-local

# --- Versions / Ports ---
ODOO_VERSION=19
ODOO_HTTP_PORT=8069
ODOO_LONGPOLL_PORT=8072

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me

# --- Odoo DB & security ---
ODOO_DB_NAME=odoo
ODOO_DB_FILTER=^odoo$
ODOO_ADMIN_PASSWORD=change-me

# --- Modules & demo data ---
ODOO_INIT_MODULES=sale,crm,contacts
# all | demo | (empty) → "all" = without demo data
ODOO_WITHOUT_DEMO=all

# --- Custom addons ---
ODOO_ADDONS_EXTRA=/mnt/extra-addons

# --- Performance (dev by default) ---
ODOO_WORKERS=0
ODOO_LIMIT_TIME_CPU=60
ODOO_LIMIT_TIME_REAL=120

# --- pgAdmin (profile pgadmin) ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
